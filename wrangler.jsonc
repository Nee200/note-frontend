{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-frontend",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "note-fragrances.de/*",
      "zone_name": "note-fragrances.de"
    },
    {
      "pattern": "www.note-fragrances.de/*",
      "zone_name": "note-fragrances.de"
    }
  ],
  "build": { "command": "npm run build" },
  "vars": { "API_ORIGIN": "https://note-backend-5gy0.onrender.com" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/create-checkout-session", "/create-pickup-order"]
  }
}
